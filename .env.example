# Proveedor del formulario de cotización: formspree | emailjs | supabase | api
# Si se deja vacío, la solicitud se envía por WhatsApp (sin backend).
VITE_FORM_PROVIDER=

# Formspree
VITE_FORMSPREE_ID=

# EmailJS
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Supabase (tabla con columnas equivalentes a los campos del formulario)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABLE=quote_requests

# API propia (POST JSON)
VITE_QUOTE_API_URL=

